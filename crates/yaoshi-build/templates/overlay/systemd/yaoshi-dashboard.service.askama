[Unit]
Description=Yaoshi Dashboard
After=local-fs.target yaoshi-prepare.service yaoshi-root-shell.service
RequiresMountsFor=/boot
Conflicts=getty@tty1.service

[Service]
ExecStart=/usr/bin/yaoshi-dashboard
StandardInput=tty
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=no
Restart=always
RestartSec=1
User=root

[Install]
WantedBy=multi-user.target
