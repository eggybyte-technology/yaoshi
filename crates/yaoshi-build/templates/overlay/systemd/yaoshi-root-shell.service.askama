[Unit]
Description=Yaoshi Root Shell
After=yaoshi-prepare.service
Before=yaoshi-dashboard.service
Requires=yaoshi-prepare.service
Conflicts=getty@tty2.service

[Service]
ExecStart=-/bin/bash --login
WorkingDirectory=/root
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty2
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
KillMode=control-group
KillSignal=SIGHUP
SendSIGHUP=yes
TimeoutStopSec=2
FinalKillSignal=SIGKILL
Restart=always
RestartSec=1
User=root

[Install]
WantedBy=multi-user.target
